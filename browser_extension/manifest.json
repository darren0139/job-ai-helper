{
  "manifest_version": 3,
  "name": "Job AI Helper — Browser Integration POC",
  "version": "0.4.6.9",
  "description": "Local JD capture with dynamic ATS adapters, faster batch preparation, Job AI Helper bridge, and deterministic safe autofill.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "optional_permissions": [
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "app_capture_background.js"
  },
  "content_scripts": [{
    "matches": ["http://127.0.0.1/*", "http://localhost/*"],
    "js": ["app_capture.js"],
    "run_at": "document_idle"
  }],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "Job AI Helper Browser Integration",
    "default_popup": "popup.html"
  }
}
