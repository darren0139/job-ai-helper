{
  "manifest_version": 3,
  "name": "Job AI Helper — Browser Integration POC",
  "version": "0.4.0",
  "description": "Local JD capture, batch tab preparation, Job AI Helper bridge, and deterministic basic-field autofill.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "optional_permissions": [
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "Job AI Helper Browser Integration",
    "default_popup": "popup.html"
  }
}
