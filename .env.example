
# MODEL=openai/gpt-4o-mini

EMBEDDING_MODEL=openai/text-embedding-3-small

# Fallback model
# MODEL=openai/gpt-5.6-terra
MODEL=gpt-4o-mini
# Initial selections shown when the app starts
ANALYSIS_MODEL=openai/gpt-5.6-luna
CHAT_MODEL=anthropic/claude-haiku-4-5-20251001

# # Mainly used by GPT-5.6
ANALYSIS_REASONING_EFFORT=low
CHAT_REASONING_EFFORT=low

# # Optional; may improve repeatability but does not guarantee it
# LLM_SEED=42

LLM_JSON_ATTEMPTS=2
LLM_API_RETRIES=3
LLM_REQUEST_TIMEOUT_SECONDS=120
LLM_REASONING_TOKEN_HEADROOM=2000
LLM_MIN_REASONING_COMPLETION_TOKENS=4000
LLM_DEBUG_TIMING=false


# Add keys only for providers you intend to select
OPENAI_API_KEY=your_openai_key
ANTHROPIC_API_KEY=your_anthropic_key
GEMINI_API_KEY=your_gemini_key

# Only needed for local Ollama
OLLAMA_API_BASE=http://localhost:11434

# Phase 6D.5 taxonomy retrieval.
# Keep lexical as the normal default. Hybrid/vector may use the embedding API.
CAPABILITY_RAG_MODE=lexical
CAPABILITY_RAG_TOP_K=5
CAPABILITY_RAG_VECTOR_THRESHOLD=0.30
